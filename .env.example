# Публичные origin, с которых приложение проксируется (через запятую).
# Их получает и проверка rwsdk (allowedOrigins), и CORS-слой.
# https://preview.opencode.pzlb.ru разрешён всегда (встроен в src/lib/env/parse.ts).
# Пример: APP_ORIGINS=https://site-a.example,https://site-b.example
APP_ORIGINS=

# framework (по умолчанию): CSRF закрыт rwsdk, CORS по списку выше.
# strict: плюс собственная проверка Origin для изменяющих запросов.
# off: только для локальных проб, не для превью и прода.
SECURITY_MODE=strict

# Разрешать Origin: null (sandbox-iframe без allow-same-origin).
# На хосте превью включено всегда; для остальных — только явно.
ALLOW_NULL_ORIGIN=

# Куки сессии. В проде по умолчанию Secure=true и префикс __Host-.
# Пусто = значение по умолчанию; 0/false — выключить, например для http в локалке.
COOKIE_SECURE=
COOKIE_PREFIX=